# Copy this file to .env and fill in your own values.
# .env is loaded automatically on startup (see internal/config/config.go).

# --- Database (PostgreSQL) ---
# Use whatever you'd type into pgAdmin's connection dialog.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=homefinance
DB_SSLMODE=disable

# --- Server ---
PORT=8080
# Secret used to sign JWT login tokens — set this to a long random string
# in any real deployment (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of origins allowed to call this API (your frontend).
FRONTEND_ORIGIN=http://localhost:5173
# Used to build links inside emails (invitations, etc).
FRONTEND_URL=http://localhost:5173

# --- Email (SMTP) ---
# Example for Gmail: use smtp.gmail.com, port 587, and an "App Password"
# (not your normal password) — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Ledger — Home Finance
SMTP_FROM_EMAIL=your-email@gmail.com

# Set to "true" to log emails to the console instead of actually sending
# them — useful while developing without real SMTP credentials.
EMAIL_DRY_RUN=true
